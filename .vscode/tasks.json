{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build"],
            "problemMatcher": []
        },
        {
            "label": "Build FlingEngine",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--target", "FlingEngine", "--config", "${command:cmake.buildType}", "--parallel"],
            "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "Build Sandbox",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--target", "Sandbox", "--config", "${command:cmake.buildType}", "--parallel"],
            "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "Build CoreTests",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--target", "CoreTests", "--config", "${command:cmake.buildType}", "--parallel"],
            "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "Build ResourcesTests",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--target", "ResourcesTests", "--config", "${command:cmake.buildType}", "--parallel"],
            "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "Build EngineTests",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--target", "EngineTests", "--config", "${command:cmake.buildType}", "--parallel"],
            "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "Build PhysicsTests",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--target", "PhysicsTests", "--config", "${command:cmake.buildType}", "--parallel"],
            "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "Build ApplicationTests",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--target", "ApplicationTests", "--config", "${command:cmake.buildType}", "--parallel"],
            "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "Build All",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--config", "${command:cmake.buildType}", "--parallel"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "Run CTest",
            "type": "shell",
            "command": "ctest",
            "args": ["--test-dir", "build", "--output-on-failure", "--no-tests=error"],
            "windows": {
                "args": ["--test-dir", "build", "-C", "${command:cmake.buildType}", "--output-on-failure", "--no-tests=error"]
            },
            "dependsOn": [
                "Build CoreTests",
                "Build ResourcesTests",
                "Build EngineTests",
                "Build PhysicsTests",
                "Build ApplicationTests"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
