#include "FlingPaths.h"

namespace Fling
{
    const String& FlingPaths::BinaryDir()
    {
    #ifdef FLING_SHIPPING
        static String BinDir = "";
    #else
        static String BinDir = "";
    #endif
        return BinDir;
    }
    
    String FlingPaths::ConvertAbsolutePathToRelative(const StringView t_FullPath)
    {
        return String(t_FullPath.substr( FlingPaths::EngineAssetsDir().length() + 1 ));
    }

    const String& FlingPaths::EngineAssetsDir()
    {
    #ifdef FLING_SHIPPING
        static String AssetPath = "Assets";
    #else
        static String AssetPath = "@FLING_ROOT_DIR@/Assets";
    #endif
        return AssetPath;
    }

    const String& FlingPaths::CompiledShaderDir()
    {
    #ifdef FLING_SHIPPING
        static String ShaderPath = "Shaders";
    #else
        static String ShaderPath = "@FLING_SHADER_OUTPUT_DIR@";
    #endif
        return ShaderPath;
    }

    const String& FlingPaths::EngineLogDir()
    {
    #ifdef FLING_SHIPPING
        static String LogPath = "Logs";
    #else
        static String LogPath = "@FLING_ROOT_DIR@/Logs";
    #endif
        return LogPath;
    }

    const String& FlingPaths::EngineConfigDir()
    {
    #ifdef FLING_SHIPPING
        static String ConfigPath = "Config";
    #else
        static String ConfigPath = "@FLING_ROOT_DIR@/Config";
    #endif
        return ConfigPath;
    }

    const String& FlingPaths::EngineSourceDir()
    {
    #ifdef FLING_SHIPPING
        static String SourceDir = "";
    #else
        static String SourceDir = "@FLING_ENGINE_SOURCE_PATH@";
    #endif
        return SourceDir;
    }
    const String& FlingPaths::ProjectDir()
    {
    #ifdef FLING_SHIPPING
        static String ProjectPath = "";
    #else
        static String ProjectPath = "@FLING_ROOT_DIR@";
    #endif
        return ProjectPath;
    }

    const String& FlingPaths::ProjectSavedDir()
    {
    #ifdef FLING_SHIPPING
        static String SavedPath = "Saved";
    #else
        static String SavedPath = ProjectDir() + "/Saved";
    #endif
        return SavedPath;
    }

}   // Fling